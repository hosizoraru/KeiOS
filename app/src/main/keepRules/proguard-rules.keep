# WebDAV stores enum names in MMKV keys, provider/state values and history identifiers.
# The two outcome enums also cross the app/module boundary through valueOf(status.name).
# Preserve constant names on both sides while allowing unused members to shrink.
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavSyncItem {
    public static final os.kei.ui.page.main.sync.WebDavSyncItem *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavProvider {
    public static final os.kei.ui.page.main.sync.WebDavProvider *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavSyncPendingState {
    public static final os.kei.ui.page.main.sync.WebDavSyncPendingState *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavAutoSyncStatus {
    public static final os.kei.ui.page.main.sync.WebDavAutoSyncStatus *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavSyncHistorySource {
    public static final os.kei.ui.page.main.sync.WebDavSyncHistorySource *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavSyncHistoryKind {
    public static final os.kei.ui.page.main.sync.WebDavSyncHistoryKind *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.sync.WebDavItemStatus {
    public static final os.kei.ui.page.main.sync.WebDavItemStatus *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.feature.webdav.sync.WebDavSyncStatus {
    public static final os.kei.feature.webdav.sync.WebDavSyncStatus *;
}

# Keep internal component class names stable for manifest lookups and About-page introspection.
# This covers future KeiOS activities/services/receivers/providers without needing manual updates.
-keep,allowshrinking,allowoptimization class os.kei.** extends android.app.Application
-keep,allowshrinking,allowoptimization class os.kei.** extends android.app.Activity
-keep,allowshrinking,allowoptimization class os.kei.** extends android.app.Service
-keep,allowshrinking,allowoptimization class os.kei.** extends android.content.BroadcastReceiver
-keep,allowshrinking,allowoptimization class os.kei.** extends android.content.ContentProvider

# Keep Miuix Nav route key type and Kotlin serialization entry points.
# Route classes are referenced directly by entry<T>; keep only restore/serializer anchors.
-keep,allowoptimization,allowobfuscation interface os.kei.ui.navigation.KeiosRoute
-keep,allowoptimization,allowobfuscation class os.kei.ui.navigation.KeiosRoute$*$$serializer { *; }
-keepclassmembers,allowoptimization,allowobfuscation class os.kei.ui.navigation.KeiosRoute$* {
    public static ** Companion;
    public static ** INSTANCE;
    public static *** serializer(...);
}

# Keep annotation/signature metadata used by Kotlin + library runtime features.
-keepattributes Signature,InnerClasses,EnclosingMethod,*Annotation*

# Module-specific rules:
# - core-notification exports local Focus V3 and Super Island facade consumer rules.
# - core-system exports Shizuku and HiddenApiBypass consumer rules.
# - feature-github keeps its managed-install Shizuku bridge surface.

# Drop direct release Log calls to reduce overhead and method count.
# AppLogger warning/error paths are kept visible for benchmark/release install diagnostics.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}

# Ktor debug probe references JDK-only management APIs on Android.
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean

# R8 diagnostics:
# - Compare app/build/outputs/mapping/{release,benchmark}/configuration.txt, mapping.txt, and usage.txt.
# - Use temporary -whyareyoukeeping rules only during local diagnosis; do not commit them.
