# ---------- KeiOS R8 baseline ----------
# Keep only enum constant names used by stores and protocols. Methods, enum helper
# fields and class names remain available for optimization and obfuscation.
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.core.prefs.AppThemeMode {
    public static final os.kei.core.prefs.AppThemeMode *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.feature.home.model.HomeOverviewCard {
    public static final os.kei.feature.home.model.HomeOverviewCard *;
}
-keepclassmembers,allowshrinking,allowoptimization enum os.kei.ui.page.main.model.BottomPage {
    public static final os.kei.ui.page.main.model.BottomPage *;
}
