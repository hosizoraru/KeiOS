*.pfx
*.pkcs12
*.key
keystore.properties
signing.properties
*.env
.env
.env.*
# Only the documented public CI debug key belongs in version control.
/app/signing/*
!/app/signing/README.md
!/app/signing/keios-ci-debug.keystore

# Temporary / local scratch
tmp/
/tmp/
/.tmp/
# Local planning scratch; publish durable plans under docs/planning/.
/.planning/
*.tmp
*.temp
*.bak
*.orig

# Local tooling state.
#
# `/.claude/*` rather than `/.claude/`: git never descends into an excluded *directory*, so a
# later negation inside one can never take effect. Excluding the contents keeps the directory
# readable, which lets skills back in — those are project content, and a skill only this machine
# can see is not a skill.
/.claude/*
!/.claude/skills/
/.codex/
/trace_processor

# Local Python / Node tooling environments and caches
.venv/
venv/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local QA artifacts
/artifacts/

# Local device QA smoke harnesses
/scripts/qa/android_api36_p0_smoke.sh
/scripts/qa/*.local.sh
/app/src/debug/AndroidManifest.xml
/app/src/debug/java/os/kei/debug/

# Root-level preview screenshots
/keios_*.png

# Local QA checklists (keep local only)
/docs/qa/mainscreen_fivepages_regression_checklist.md
/scripts/qa/refactor_regression_gate.sh
/docs/miuix-blur-adoption-plan.md
docs/小米超级岛模板库20260129.pdf

# Python bytecode from the perf harness
__pycache__/
*.py[cod]
*$py.class
