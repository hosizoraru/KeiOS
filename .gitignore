# Gradle projects live at the root; assets and docs also contain build/ directories.
/build/
/*/build/
!/docs/build/
**/outputs/
**/reports/
**/test-results/

# Keep Gradle wrapper tracked
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

# Android local config
local.properties

# Native / NDK
.cxx/
.externalNativeBuild/

